# Microsoft Entra External ID(外部テナント)
VITE_ENTRA_CLIENT_ID=
# 例: https://<テナントのサブドメイン>.ciamlogin.com/(サブドメインはプライマリドメイン <サブドメイン>.onmicrosoft.com の先頭部分)
VITE_ENTRA_AUTHORITY=
# APIを保護する場合のスコープ(例: api://<API用クライアントID>/access_as_user)
VITE_ENTRA_API_SCOPE=

# Application Insights(ブラウザ側)
VITE_APPINSIGHTS_CONNECTION_STRING=
